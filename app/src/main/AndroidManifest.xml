<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The GPS dot. Coarse is listed too so Android 12+ can offer "approximate";
         the app explains that the dot needs precise. No background location: tracking with the
         screen off runs in a foreground service that the visible app starts, which while-in-use
         location covers. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The flight-tracking foreground service (type location) and its notification. On Android 13+
         notifications are asked for when the user starts tracking; tracking runs without them. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The app exists to show a GPS position, so app stores shouldn't offer it to
         devices without satellite GPS (lint warns about that; it is the point here).
         The app still checks at runtime. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="true"
        tools:ignore="UnnecessaryRequiredFeature" />

    <!-- MapLibre's manifest asks for Wi-Fi state, but no code in the app or MapLibre reads it.
         (MapLibre also merges INTERNET and ACCESS_NETWORK_STATE: its connectivity check needs
         the latter, and route downloads will need INTERNET from Milestone 4.) -->
    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE"
        tools:node="remove" />

    <application
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Flyoff">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Records the flight with the screen off; only the app itself starts or stops it. -->
        <service
            android:name=".tracking.FlightTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>
