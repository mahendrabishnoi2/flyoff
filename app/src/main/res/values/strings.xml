<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Flyoff</string>

    <!-- Location permission -->
    <string name="permission_title">Show your position</string>
    <string name="permission_body">Flyoff uses your phone\'s GPS to put you on the map. GPS works in airplane mode and needs no internet. Your location stays on your phone.</string>
    <string name="permission_allow">Allow location</string>
    <string name="permission_blocked_title">Location permission is off</string>
    <string name="permission_blocked_body">To see your position, allow location for Flyoff in app settings and choose Precise.</string>
    <string name="approximate_title">Precise location needed</string>
    <string name="approximate_body">Flyoff has approximate location only. It can be kilometres off and updates rarely, too rough to follow a plane.</string>
    <string name="approximate_allow">Use precise location</string>
    <string name="open_app_settings">Open settings</string>
    <string name="ask_again">Ask again</string>

    <!-- GPS status -->
    <string name="gps_off_title">Location is off</string>
    <string name="gps_off_body">Turn on location to use GPS. It works in airplane mode and needs no internet.</string>
    <string name="open_location_settings">Location settings</string>
    <string name="gps_waiting_title">Waiting for GPS…</string>
    <string name="gps_waiting_body">Without internet, the first fix can take several minutes. Get a fix before boarding, and keep the phone near a window.</string>
    <string name="gps_fix_title">GPS</string>
    <string name="follow_me">Follow me</string>
    <string name="no_gps_title">No GPS receiver</string>
    <string name="no_gps_body">This device has no GPS receiver, so Flyoff can\'t show your position. The map still works.</string>

