    <string name="download_flight_data">Download</string>
    <string name="not_now">Not now</string>
    <string name="flight_data_downloading">Downloading flight routes (%1$s)…</string>
    <string name="flight_data_updated">Flight routes updated to %1$s.</string>
    <string name="flight_data_wifi_required">Not on Wi-Fi. Connect to Wi-Fi, or allow mobile data in Stored maps.</string>
    <string name="flight_data_no_connection">Couldn\'t reach Flyoff\'s flight data. Check the connection and try again.</string>
    <string name="flight_data_bad_file">The download didn\'t pass its checks, so Flyoff kept the flight routes it has.</string>
    <string name="flight_data_storage">The flight routes couldn\'t be stored on this phone.</string>
    <string name="flight_data_tracking">Flyoff uses no network while tracking. Update before or after the flight.</string>

